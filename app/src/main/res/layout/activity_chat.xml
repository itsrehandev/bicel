<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/extra_light_grey"
    android:scrollbars="none"
    tools:context=".ChatActivity">



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:layout_gravity="top"
                android:background="@color/white"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/backBtn"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="match_parent"
                    android:rotation="90"
                    android:src="@drawable/down_arrow_icon_2"
                    app:layout_constraintStart_toStartOf="parent" />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/receiverImg"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:src="@drawable/pexels_michael_block_1691617_3225517"
                    app:layout_constraintStart_toEndOf="@id/backBtn"

                    />

                <TextView
                    android:id="@+id/receiverName"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/kumbh_sans"
                    android:gravity="center"
                    android:text="Muhammad kashan"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14sdp"
                    app:layout_constraintStart_toEndOf="@id/receiverImg" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messagesRv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/_3sdp"
                app:layout_constraintBottom_toTopOf="@id/bottomLayout"
                app:layout_constraintTop_toBottomOf="@id/topLayout"
                tools:listitem="@layout/send_message" />
            <LinearLayout
                android:id="@+id/messagesProgress"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:background="@color/overlay_grey"
                app:layout_constraintTop_toTopOf="@id/messagesRv"
                app:layout_constraintStart_toStartOf="@id/messagesRv"
                app:layout_constraintBottom_toBottomOf="@id/messagesRv"
                app:layout_constraintEnd_toEndOf="@id/messagesRv">
            <ProgressBar
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:indeterminateTint="@color/colorPrimary"

                />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/bottomLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/messagesRv">

                <EditText
                    android:id="@+id/messageEt"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/message_et"
                    android:hint="Message"
                    android:paddingStart="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/dark_grey" />

                <ImageView
                    android:id="@+id/sendMessage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.13"
                    android:src="@drawable/send_msg_icon" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>