<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragments.Account">

    <LinearLayout
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_black"
        android:elevation="4dp"
        android:gravity="center"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:indeterminateTint="@color/colorPrimary" />
    </LinearLayout>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/unloggedScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:visibility="gone"
    android:elevation="4dp"
    >
    <ImageView
        android:id="@+id/personimg"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="@dimen/_180sdp"
        android:src="@drawable/not_logged_in_person_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:id="@+id/tv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Oops! You are not logged in yet"
        android:textSize="@dimen/_17sdp"
        android:textStyle="bold"

        android:layout_marginHorizontal="@dimen/_20sdp"
        android:fontFamily="@font/kumbh_sans"
        app:layout_constraintTop_toBottomOf="@id/personimg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:id="@+id/tv2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login to see your account details"
        android:textSize="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:id="@+id/loginBtn"
        android:layout_width="@dimen/_200sdp"
        android:layout_height="wrap_content"
        android:text="Login"
        android:fontFamily="@font/poppins"
        android:textStyle="bold"
        android:background="@drawable/login_btn_bg"
        android:textSize="@dimen/_16sdp"
        android:gravity="center"
        android:layout_marginTop="@dimen/_40sdp"
        android:textColor="@color/white"
        android:paddingVertical="@dimen/_9sdp"
        app:layout_constraintTop_toBottomOf="@id/tv2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/editProfileScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:translationX="0dp"
        android:fillViewport="true"
        >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <TextView
            android:id="@+id/editprofileheading"
            android:layout_width="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/poppins"
            android:layout_height="wrap_content"
            android:text="Edit your profile"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <ImageView
            android:id="@+id/closeEditProfileBtn"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/add_icon_6"
            android:rotation="45"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="@dimen/_10sdp"
            />
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/editUserImg"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            app:layout_constraintTop_toBottomOf="@id/editprofileheading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/profilePicSelectBtn"
            android:layout_marginTop="@dimen/_50sdp"
            app:layout_constraintHorizontal_chainStyle="packed"
            />

        <TextView
            android:id="@+id/profilePicSelectBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:background="@drawable/select_profile_pic_bg_6"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="@dimen/_30sdp"
            android:paddingVertical="@dimen/_20sdp"
            android:text="Select Profile Picture"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@id/editUserImg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/editUserImg"
            app:layout_constraintTop_toTopOf="@id/editUserImg" />
        <TextView
            android:id="@+id/editnameheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Edit Name"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_30sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editUserImg"
            />
        <EditText
            android:id="@+id/editName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Enter your new name"
            android:padding="@dimen/_10sdp"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/black"
            android:background="@drawable/login_et_bg"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintTop_toBottomOf="@id/editnameheading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <TextView
            android:id="@+id/editphoneheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Edit Phone number"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editName"
            />
        <EditText
            android:id="@+id/editPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Enter your new Phone number"
            android:padding="@dimen/_10sdp"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/black"
            android:background="@drawable/login_et_bg"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintTop_toBottomOf="@id/editphoneheading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <TextView
            android:id="@+id/cancelEditBtn"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_40sdp"
            android:text="Cancel"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp"
            android:fontFamily="@font/blinker"
            android:gravity="center"
            android:layout_marginTop="@dimen/_60sdp"
            android:background="@drawable/cancel_btn_bg"
            app:layout_constraintTop_toBottomOf="@id/editPhone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/saveEditBtn"
            app:layout_constraintHorizontal_chainStyle="packed"
            android:layout_marginEnd="@dimen/_10sdp"
            />
        <TextView
            android:id="@+id/saveEditBtn"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_40sdp"
            android:text="Save Changes"
            android:background="@drawable/save_btn_bg"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp"
            android:fontFamily="@font/blinker"
            android:gravity="center"
            android:layout_marginTop="@dimen/_60sdp"
            app:layout_constraintTop_toBottomOf="@id/editPhone"
            app:layout_constraintStart_toEndOf="@id/cancelEditBtn"
            app:layout_constraintEnd_toEndOf="parent"

            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <ScrollView
        android:visibility="gone"
        android:id="@+id/loggedScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/userImg"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/userName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sdp"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/_17sdp"
                app:layout_constraintWidth_percent="0.7"
                app:layout_constraintBottom_toBottomOf="@id/userImg"
                app:layout_constraintStart_toEndOf="@id/userImg"
                app:layout_constraintTop_toTopOf="@id/userImg" />
            <View
                android:id="@+id/imgview"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey"
                app:layout_constraintBottom_toTopOf="@id/emaillinear"
                />
            <LinearLayout
                android:id="@+id/emaillinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintTop_toBottomOf="@id/userImg"
                android:background="@color/almost_white"
                android:paddingVertical="@dimen/_8sdp"
                android:paddingStart="@dimen/_19sdp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_14sdp"
                    android:text="Email:"
                    android:layout_gravity="center"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold"/>
            <TextView
                android:id="@+id/userEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_6sdp"
                />
            </LinearLayout>
            <View
                android:id="@+id/emailview"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey"
                app:layout_constraintTop_toBottomOf="@id/emaillinear"
                />
            <LinearLayout
                android:id="@+id/phoneLinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/almost_white"
                android:paddingVertical="@dimen/_8sdp"
                android:paddingStart="@dimen/_19sdp"
                app:layout_constraintTop_toBottomOf="@id/emailview"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_14sdp"
                    android:text="Phone:"
                    android:fontFamily="@font/poppins"
                    android:textStyle="bold"/>
            <TextView
                android:id="@+id/userPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/_14sdp"
                android:text="95049504"
                android:layout_marginStart="@dimen/_6sdp"
                android:letterSpacing="0.034"
                />
            </LinearLayout>
            <View
                android:id="@+id/phoneview"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey"
                app:layout_constraintTop_toBottomOf="@id/phoneLinear"
                />
            <TextView
                android:id="@+id/editProfileBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit profile"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp"
                android:paddingStart="@dimen/_20sdp"
                android:paddingVertical="@dimen/_13sdp"
                android:background="@color/almost_white"
                app:layout_constraintTop_toBottomOf="@id/phoneview"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            <View
                android:id="@+id/editview"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey"
                app:layout_constraintTop_toBottomOf="@id/editProfileBtn"
                />
            <TextView
                android:id="@+id/logoutBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textColor="@color/red"
                android:textSize="@dimen/_13sdp"
                android:paddingStart="@dimen/_20sdp"
                android:paddingVertical="@dimen/_13sdp"
                android:background="@drawable/logout_ripple"
                app:layout_constraintTop_toBottomOf="@id/editview"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            <View
                android:id="@+id/logoutview"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey"
                app:layout_constraintTop_toBottomOf="@id/logoutBtn"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>