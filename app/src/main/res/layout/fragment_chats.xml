<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".fragments.Chats">
<TextView
    android:id="@+id/heading"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Chats"
    android:textSize="@dimen/_25sdp"
    android:fontFamily="@font/poppins"
    android:textStyle="bold"
    android:textColor="@color/colorPrimaryDark"
    android:layout_marginTop="@dimen/_3sdp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_bias="0.16"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
  />
<!--    Contact Options Tab -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contactOptTable"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@color/almost_white"
        app:layout_constraintTop_toTopOf="parent"
        >
        <ImageView
            android:id="@+id/cancelContactOpt"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/add_icon_6"
            android:rotation="45"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/almost_black"/>
        <TextView
            android:id="@+id/selectContactTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/_18sdp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins"
            app:layout_constraintStart_toEndOf="@id/cancelContactOpt"
            app:layout_constraintTop_toTopOf="@id/cancelContactOpt"
            app:layout_constraintBottom_toBottomOf="@id/cancelContactOpt"
            android:layout_marginStart="@dimen/_10sdp"
            />
        <ImageView
            android:id="@+id/deleteContact"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="match_parent"
            android:src="@drawable/delete_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            android:padding="@dimen/_12sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/almost_black"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/heading"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <EditText
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:hint="Search"
                android:paddingStart="@dimen/_35sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:background="@drawable/search_bg_2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:layout_width="@dimen/_25sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_height="@dimen/_23sdp"
                android:src="@drawable/search_icon_2"
                app:layout_constraintStart_toStartOf="@id/searchView"
                app:layout_constraintTop_toTopOf="@id/searchView"
                app:layout_constraintBottom_toBottomOf="@id/searchView"
                />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/searchView"
                >
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/CustomChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textSize="@dimen/_13sdp"

                    />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBuying"
                    style="@style/CustomChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buying"

                    />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSelling"
                    style="@style/CustomChipStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selling"
                    />
            </com.google.android.material.chip.ChipGroup>
            <TextView
                android:id="@+id/noChatsTv"
                android:layout_width="0dp"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:text="Your chats will appear here. Currently you don't have any"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroup"
                android:elevation="4dp"
                android:textColor="@color/black"
                android:textSize="@dimen/_17sdp"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="@dimen/_100sdp"
                app:layout_constraintWidth_percent="0.8"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatUsersRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chipGroup"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>